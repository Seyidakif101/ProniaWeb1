@model List<Shipping>
<div class="container">
    <div class="row">
        <div class="row">
            <div class="col-2">
		<a class="btn btn-primary mb-3" asp-action="Create">Create</a>

            </div>
        </div>
        <table class="table table-hover table-dark">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">ImageUrl</th>
                    <th scope="col">Actions</th>

                </tr>
            </thead>
            <tbody>
                @foreach (Shipping shipping in Model)
                {
                    <tr>
                        <th scope="row">@shipping.Id</th>
                        <td>@shipping.Name</td>
                        <td>@shipping.Description</td>
                        <td><img src="~/assets/images/website-images/@shipping.ImageUrl"width="40" height="40" alt="Alternate Text"/> </td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@shipping.Id" class="btn btn-danger">Delete</a>
                            <a class="btn btn-warning">Update</a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

