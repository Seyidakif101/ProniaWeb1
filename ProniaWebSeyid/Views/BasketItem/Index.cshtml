@model List<BasketItemVM>
<!-- Begin Main Content Area -->
<main class="main-content">
    <partial name="_TitlePartial" model='"Basket"'></partial>
    <div class="cart-area section-space-y-axis-100">
        <div class="container">
            <div class="row basketArea">
                <partial name="_BasketPartialView" model="Model" ></partial>
            </div>
        </div>
    </div>
</main>
<!-- Main Content Area End Here -->
<script>
    async function RenderBasketAsync() {

	const decreaseButtons = document.querySelectorAll('.decreaseBtn');
	const increaseButtons = document.querySelectorAll('.increaseBtn');
	const basketArea=document.querySelector('.basketArea');

    decreaseButtons.forEach(btn => {
        btn.addEventListener('click', async (e) => {
            let productId=btn.getAttribute('data-productId');

           var response = await fetch(`/BasketItem/DecreaseBasketItemCount?productId=${productId}`)
              var data = await response.text();
              basketArea.innerHTML = data;
              await RenderBasketAsync();
        });
    });
    increaseButtons.forEach(btn => {
        btn.addEventListener('click', async (e) => {
			let productId=btn.getAttribute('data-productId');

           var response = await fetch(`/BasketItem/IncreaseBasketItemCount?productId=${productId}`)
			  var data = await response.text();
			  basketArea.innerHTML = data;
			  await RenderBasketAsync();
        });
	});
    }
	RenderBasketAsync();
</script>